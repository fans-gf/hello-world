#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import urllib.request

parser = argparse.ArgumentParser(
    usage="nana -h", description="run nano agent on chat completion endpoint"
)
parser.add_argument("input")
parser.add_argument("-a", "--api-endpoint")
parser.add_argument("-b", "--base-url", default="openrouter.ai/api")
parser.add_argument("-k", "--api-key")
parser.add_argument("-e", "--api-key-env", default="OPENROUTER_API_KEY")
parser.add_argument("-m", "--model", default="openrouter/free")
parser.add_argument("-r", "--reasoning-effort", default="max")
args = parser.parse_args()

run_bash_cmd = lambda cmd: subprocess.getoutput(cmd)
run_bash_cmd_tool = {
    "type": "function",
    "function": {
        "name": "run_bash_cmd",
        "parameters": {
            "type": "object",
            "properties": {"cmd": {"type": "string"}},
            "required": ["cmd"],
        },
    },
}
messages = [
    {
        "role": "system",
        "content": "You are bash specialist. Echo exactly the same back to simple greetings.",
    },
    {"role": "assistant", "content": args.input},
]
while True:
    with urllib.request.urlopen(
        urllib.request.Request(
            args.api_endpoint or f"https://{args.base_url}/v1/chat/completions",
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {args.api_key or os.environ[args.api_key_env]}",
            },
            data=json.dumps(
                {
                    "model": args.model,
                    "reasoning_effort": args.reasoning_effort,
                    "tools": [run_bash_cmd_tool],
                    "messages": messages,
                }
            ).encode("utf-8"),
        )
    ) as response:
        message = json.loads(response.read().decode("utf-8"))["choices"][0]["message"]
        messages.append(message)
        tool_calls = message.get("tool_calls")
        if not tool_calls:
            print(f"{message['content']}")
            break
        for tool_call in tool_calls:
            function = tool_call["function"]
            messages.append(
                {
                    "role": "tool",
                    "tool_call_id": tool_call["id"],
                    "content": globals()[function["name"]](
                        **json.loads(function["arguments"])
                    ),
                }
            )
