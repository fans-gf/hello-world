#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import urllib.request

parser = argparse.ArgumentParser(usage="nana -h", description="run nano agent on chat completion endpoint")
parser.add_argument("input")
parser.add_argument("-a", "--api-endpoint")
parser.add_argument("-b", "--base-url", default="openrouter.ai/api")
parser.add_argument("-k", "--api-key")
parser.add_argument("-e", "--api-key-env", default="OPENROUTER_API_KEY")
parser.add_argument("-m", "--model", default="openrouter/free")
parser.add_argument("-r", "--reasoning-effort", default="max")
args = parser.parse_args()

messages = [
    {"role": "system", "content": "You are bash specialist. Do nothing but echo exactly the same back to simple greetings."},
    {"role": "assistant", "content": args.input},
]
while True:
    with urllib.request.urlopen(
        urllib.request.Request(
            args.api_endpoint or f"https://{args.base_url}/v1/chat/completions",
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {args.api_key or os.environ[args.api_key_env]}",
            },
            data=json.dumps(
                {
                    "model": args.model,
                    "reasoning_effort": args.reasoning_effort,
                    "tools": [
                        {
                            "type": "function",
                            "function": {
                                "name": "run_bash_cmd",
                                "parameters": {"type": "object", "properties": {"cmd": {"type": "string"}}, "required": ["cmd"]},
                            },
                        }
                    ],
                    "messages": messages,
                }
            ).encode("utf-8"),
        )
    ) as response:
        messages.append(json.loads(response.read().decode("utf-8"))["choices"][0]["message"])
        if not messages[-1].get("tool_calls"):
            print(f"{messages[-1]['content']}")
            break
        messages.extend(
            {
                "role": "tool",
                "tool_call_id": tool_call["id"],
                "content": subprocess.getoutput(**json.loads(tool_call["function"]["arguments"])),
            }
            for tool_call in messages[-1]["tool_calls"]
        )
